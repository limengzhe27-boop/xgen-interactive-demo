# Copy this file to .env.local and insert newly rotated keys.
# Never commit .env.local or paste production keys into client-side code.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

SILICONFLOW_API_KEY=
SILICONFLOW_IMAGE_MODEL=Tongyi-MAI/Z-Image-Turbo
SILICONFLOW_IMAGE_SIZE=1024x576
# Optional per-purpose overrides; empty uses IMAGE_MODEL (Turbo by default).
# No automatic switch to a more expensive model and no automatic retries.
SILICONFLOW_SCENE_MODEL=
SILICONFLOW_PORTRAIT_MODEL=

# Server-only Supabase keys. Never expose secrets with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
IMAGE_SESSION_SECRET=
SUPABASE_PUBLISHABLE_KEY=
# Enable only after the corresponding Supabase OAuth provider is configured.
AUTH_PROVIDER=
