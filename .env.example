# Copy this file to .env.local and insert newly rotated keys.
# Never commit .env.local or paste production keys into client-side code.
YIBU_API_KEY=
YIBU_BASE_URL=https://yibuapi.com
YIBU_TEXT_MODEL=deepseek-v4-flash
YIBU_IMAGE_MODEL=doubao-seedream-4-0-250828
YIBU_SCENE_MODEL=
YIBU_PORTRAIT_MODEL=
YIBU_VIDEO_MODEL=kling-video-o1
YIBU_SPEECH_MODEL=doubao-tts
# No automatic premium upgrade, direct-provider fallback, or media resubmission.

# Server-only Supabase keys. Never expose secrets with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
IMAGE_SESSION_SECRET=
SUPABASE_PUBLISHABLE_KEY=
# Enable only after the corresponding Supabase OAuth provider is configured.
AUTH_PROVIDER=
# Keep false until author management and publication acceptance tests are complete.
WORLD_PUBLICATION_ENABLED=false

# Server-only fal H3 Max video pilot. Never use a NEXT_PUBLIC_ name.
FAL_KEY=
